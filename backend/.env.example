# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret - Generate a strong secret key for production
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Supabase Configuration
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Database Configuration (optional - for future PostgreSQL migration)
# DATABASE_URL=postgresql://user:password@localhost:5432/grychat

# Redis Configuration (optional - for session caching)
# REDIS_URL=redis://localhost:6379
