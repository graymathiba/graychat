# GryChat Environment Variables
# Backend
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://grychat.com

# Firebase Admin SDK
# IMPORTANT: Generate a NEW service account key from Firebase Console
# Go to: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=

# Firebase (from Firebase Console → Project Settings → General)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Backend URL
BACKEND_URL=http://127.0.0.1:3000

# Continue.dev AI
GEMINI_API_KEY=
