# =============================================================================
# GryChat Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── Backend (backend/.env) ─────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_secret

# Supabase (get these from your Supabase project dashboard)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Flutter (pass with --dart-define at build/run time) ────────────────────
#
# Run the app:
#   flutter run --dart-define=SUPABASE_URL=https://... --dart-define=SUPABASE_ANON_KEY=...
#
# Build:
#   flutter build windows --debug ^
#     --dart-define=SUPABASE_URL=https://... ^
#     --dart-define=SUPABASE_ANON_KEY=... ^
#     --dart-define=FIREBASE_API_KEY=... ^
#     --dart-define=FIREBASE_AUTH_DOMAIN=... ^
#     --dart-define=FIREBASE_PROJECT_ID=... ^
#     --dart-define=FIREBASE_STORAGE_BUCKET=... ^
#     --dart-define=FIREBASE_MESSAGING_SENDER_ID=... ^
#     --dart-define=FIREBASE_APP_ID=...
#
# Firebase config values (from Firebase Console → Project Settings → General)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Supabase (same as backend values above)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Backend URL (default: http://127.0.0.1:3000)
BACKEND_URL=http://127.0.0.1:3000

# ─── Continue.dev AI Config (.continue/agents/new-config.yaml) ──────────────
# Get from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
